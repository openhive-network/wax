{
  "name": "@hiveio/wax",
  "version": "0.0.1-LastGitTagPlaceholder.GitHashPlaceholder",
  "description": "Provides Hive Protocol features to JavaScript",
  "main": "wasm/dist/bundle/web.js",
  "types": "wasm/dist/bundle/index.d.ts",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b",
  "scripts": {
    "prebuild": "cd ../ && husky install ts/.husky && cd ./ts && ./scripts/compile_proto_ts.sh && rimraf wasm/dist",
    "rebuildall": "rimraf wasm/dist && rimraf wasm/build_wasm && wasm/build_wasm_wax.sh && tsc",
    "build": "wasm/build_wasm_wax.sh && tsc",
    "postbuild": "rollup -c && tsx ./npm-common-config/ts-common/terser.ts && size-limit",
    "build:test": "tsc --project wasm/configs/tsconfig.tests.json",
    "pretest": "playwright install chromium",
    "testserver": "node ./scripts/run-server.js",
    "test": "unset CI && playwright test --workers 4 --max-failures 1",
    "benchmark": "unset CI && playwright test --workers 4 --max-failures 1 --project=wax_testsuite_protocol_benchmarks",
    "examples": "run-s examples:*",
    "examples:memory-used": "cd ../examples/ts/memory-used && pnpm install && pnpm run test && cd ../../../ts",
    "examples:html": "cd ../examples/ts/html && pnpm install && pnpm run test && cd ../../../ts",
    "examples:nextjs-app": "cd ../examples/ts/nextjs-app && pnpm install && pnpm run build && cd ../../../ts",
    "examples:node-app": "cd ../examples/ts/node-app && pnpm install && pnpm run test && cd ../../../ts",
    "examples:vue-webpack": "cd ../examples/ts/vue-webpack && pnpm install && pnpm run build && cd ../../../ts",
    "examples:vue-vite": "cd ../examples/ts/vue-vite && pnpm install && pnpm run test && pnpm run build && cd ../../../ts",
    "examples:react-vite": "cd ../examples/ts/react-vite && pnpm install && pnpm run test && pnpm run build && cd ../../../ts",
    "examples:nuxt-app": "cd ../examples/ts/nuxt-app && pnpm install --config.engine-strict=false && pnpm run test && pnpm run build && cd ../../../ts",
    "examples:signature-extension": "cd ../examples/ts/signature-extension && pnpm install && pnpm run build && pnpm run test && cd ../../../ts"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./wasm/dist/bundle/index.d.ts",
          "default": "./wasm/dist/bundle/node.js"
        }
      },
      "default": {
        "import": {
          "types": "./wasm/dist/bundle/index.d.ts",
          "default": "./wasm/dist/bundle/web.js"
        }
      }
    },
    "./web": {
      "import": {
        "types": "./wasm/dist/bundle/index.d.ts",
        "default": "./wasm/dist/bundle/web.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./wasm/dist/bundle/index.d.ts",
        "default": "./wasm/dist/bundle/vite.js"
      }
    },
    "./node": {
      "import": {
        "types": "./wasm/dist/bundle/index.d.ts",
        "default": "./wasm/dist/bundle/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@hiveio/beekeeper": "1.27.12",
    "@playwright/test": "catalog:playwright-toolset",
    "@rollup/plugin-commonjs": "catalog:rollup-toolset",
    "@rollup/plugin-node-resolve": "catalog:rollup-toolset",
    "@rollup/plugin-replace": "catalog:rollup-toolset",
    "@size-limit/file": "catalog:size-limit-toolset",
    "@types/cors": "^2.8.17",
    "@types/events": "^3.0.3",
    "@types/express": "^5.0.0",
    "@types/express-http-proxy": "^1.6.6",
    "@types/node": "^22.10.6",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.1",
    "husky": "catalog:husky",
    "npm-run-all": "^4.1.5",
    "playwright": "catalog:playwright-toolset",
    "protobufjs": "catalog:proto-toolset",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rollup": "catalog:rollup-toolset",
    "rollup-plugin-copy": "catalog:rollup-toolset",
    "rollup-plugin-dts": "catalog:rollup-toolset",
    "size-limit": "catalog:size-limit-toolset",
    "terser": "catalog:terser",
    "ts-proto": "catalog:proto-toolset",
    "tslib": "catalog:typescript-toolset",
    "tsx": "catalog:typescript-toolset",
    "typedoc": "catalog:typedoc-toolset",
    "typedoc-gitlab-wiki-theme": "catalog:typedoc-toolset",
    "typedoc-plugin-markdown": "catalog:typedoc-toolset",
    "typescript": "catalog:typescript-toolset"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "size-limit": [
    {
      "path": [
        "./wasm/dist/bundle"
      ],
      "limit": "5600 kB",
      "brotli": false
    }
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "blockchain",
    "hive"
  ],
  "files": [
    "LICENSE.md",
    "README.md",
    "wasm/dist/bundle"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitlab.syncad.com/hive/wax.git"
  },
  "engines": {
    "node": "^20.11 || >= 21.2"
  },
  "publishConfig": {
    "registry": "https://RegistryPlaceholder",
    "tag": "DistTagPlaceholder"
  }
}
