# CI base image for building Python wheels using official PyPA manylinux
# Based on quay.io/pypa/manylinux_2_34_x86_64 with Boost built for wax compilation
#
# This image supports Python 3.12, 3.13, and 3.14 via /opt/python/cpXXX-cpXXX/bin/python
#
# Build: docker build -f Dockerfile.ci -t wax-ci-base-image .
# Usage in CI: see .gitlab-ci.yml build_wheel job

FROM quay.io/pypa/manylinux_2_34_x86_64 AS boost_builder

ARG BOOST_VERSION_TAG=boost-1.83.0
ENV BOOST_VERSION_TAG=${BOOST_VERSION_TAG}
ENV TMP_SRC=/tmp/boost_src
ENV WAX_BOOST_ROOT=/wax_boost_root

# Clone Boost source
RUN mkdir -vp "${TMP_SRC}" && \
    cd "${TMP_SRC}" && \
    git clone --recurse-submodules --shallow-submodules --single-branch --depth=1 --branch ${BOOST_VERSION_TAG} https://github.com/boostorg/boost.git

# Build Boost with static linking
RUN mkdir -vp "${WAX_BOOST_ROOT}" && \
    cd "${TMP_SRC}/boost" && \
    ./bootstrap.sh --without-icu --prefix="${WAX_BOOST_ROOT}" && \
    ./b2 \
        --build-dir="${TMP_SRC}/boost_build/" \
        --prefix="${WAX_BOOST_ROOT}" \
        -j "$(nproc)" \
        -q \
        cxxflags=-fPIC \
        runtime-link=static \
        link=static \
        threading=multi \
        --with-chrono \
        --with-context \
        --with-coroutine \
        --with-filesystem \
        --with-system \
        --with-thread \
        --with-test \
        install && \
    rm -rf "${TMP_SRC}"

# Final image with Boost installed
FROM quay.io/pypa/manylinux_2_34_x86_64

ENV WAX_BOOST_ROOT=/wax_boost_root

# Copy pre-built Boost libraries
COPY --from=boost_builder ${WAX_BOOST_ROOT} ${WAX_BOOST_ROOT}

# Install additional build tools
RUN yum install -y ninja-build && yum clean all

# Install Node.js (needed for flatten_swagger.js in API package generation)
RUN curl -fsSL https://rpm.nodesource.com/setup_20.x | bash - && \
    yum install -y nodejs && \
    yum clean all && \
    node --version && npm --version

# Python versions available in manylinux_2_34:
# /opt/python/cp312-cp312/bin/python (Python 3.12)
# /opt/python/cp313-cp313/bin/python (Python 3.13)
# /opt/python/cp314-cp314/bin/python (Python 3.14)

WORKDIR /wax
